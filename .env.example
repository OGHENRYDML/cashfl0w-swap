# Copy this file to .env and fill in your values.
# All variables are optional except FEE_RECIPIENT.

# 0x API key (required for swaps — free at https://dashboard.0x.org/apps)
ZEROEX_API_KEY=your_0x_api_key

# Your wallet — receives the affiliate fee on-chain (must not be the zero address)
FEE_RECIPIENT=0xYourWallet

# Our fee in basis points (10 = 0.10%). 0x takes 0.15% on select pairs.
FEE_BPS=10

# Collect the fee in the buy or sell token
FEE_TOKEN=buy

# Default chain id (8453 = Base)
CHAIN_ID=8453

# RPC endpoint used by the /fees endpoint
RPC_URL=https://mainnet.base.org
